<Window x:Class="CFServerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarFight 서버 런처"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="720">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="프로필" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="프로필" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding CanEditProfiles}"
                          Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="새 프로필" Command="{Binding NewProfileCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="프로필 저장" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="프로필 삭제" Command="{Binding DeleteProfileCommand}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="서버 설정" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="서버 실행 파일" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ServerExePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProfiles}" Margin="0,0,8,8" />
                <Button Grid.Row="0" Grid.Column="2" Content="찾아보기" Command="{Binding BrowseExeCommand}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="작업 폴더" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkingDir, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProfiles}" Margin="0,0,8,8" />
                <Button Grid.Row="1" Grid.Column="2" Content="찾아보기" Command="{Binding BrowseWorkDirCommand}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="맵 경로" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MapPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProfiles}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="포트" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProfiles}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="로그 파일" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LogFilePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProfiles}" Margin="0,0,8,8" />
                <Button Grid.Row="4" Grid.Column="2" Content="찾아보기" Command="{Binding BrowseLogFileCommand}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="실행 로그 파일" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ActiveLogFilePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="추가 인자" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProfiles}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="실행 제어 / 상태" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="서버 시작" Command="{Binding StartCommand}" Width="100" Margin="0,0,8,0" />
                    <Button Content="서버 종료" Command="{Binding StopCommand}" Width="100" Margin="0,0,8,0" />
                    <Button Content="설정 저장" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" />
                    <Button Content="설정 불러오기" Command="{Binding LoadCommand}" Width="110" Margin="0,0,8,0" />
                    <Button Content="기본값 적용" Command="{Binding ResetCommand}" Width="110" Margin="0,0,8,0" />
                    <Button Content="로그 지우기" Command="{Binding ClearLogCommand}" Width="100" />
                    <CheckBox Content="자동 스크롤" IsChecked="{Binding AutoScrollLog}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="상태" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" />
                    <TextBlock Grid.Column="2" Text="PID" FontWeight="Bold" />
                    <TextBlock Grid.Column="3" Text="{Binding PidText}" />
                    <TextBlock Grid.Column="4" Text="시작 시각" FontWeight="Bold" />
                    <TextBlock Grid.Column="5" Text="{Binding StartTimeText}" />
                    <TextBlock Grid.Column="6" Text="종료 코드" FontWeight="Bold" />
                    <TextBlock Grid.Column="7" Text="{Binding ExitCodeText}" />
                    <TextBlock Grid.Column="8" Text="마지막 오류" FontWeight="Bold" />
                    <TextBlock Grid.Column="9" Text="{Binding LastError}" TextWrapping="Wrap" Foreground="DarkRed" />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="실행 인자 미리보기" Padding="10" Margin="0,0,0,10">
            <TextBox Text="{Binding ArgPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="54" VerticalScrollBarVisibility="Auto" />
        </GroupBox>

        <TextBlock Grid.Row="4" Text="최근 서버 로그" FontWeight="Bold" Margin="0,0,0,6" />

        <TextBox x:Name="LogTextBox"
                 Grid.Row="5"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextChanged="HandleLogTextChanged" />

        <TextBlock Grid.Row="6"
                   Text="{Binding AppVersionText}"
                   HorizontalAlignment="Right"
                   Foreground="DimGray"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
